#!/usr/bin/env bash
# Build the release zip: one ForeverUnitFrames folder with exactly what
# ./install copies (TOC files and Media), nothing else.
#   tools/package            -> dist/ForeverUnitFrames-<version>.zip
set -eu
HERE="$(cd "$(dirname "$0")/.." && pwd)"
VERSION="$(sed -n 's/^## Version: *//p' "$HERE/ForeverUnitFrames.toc" | tr -d '\r')"
STAGE="$(mktemp -d)"
trap 'rm -rf "$STAGE"' EXIT
"$HERE/install" "$STAGE" >/dev/null
mkdir -p "$HERE/dist"
OUT="$HERE/dist/ForeverUnitFrames-$VERSION.zip"
rm -f "$OUT"
(cd "$STAGE" && zip -qrX "$OUT" ForeverUnitFrames)
echo "$OUT"
